.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
~$*.xlsx
literature/
venv/
.venv/
.env

# Derived data is not tracked by default.
*.csv
*.rds
*.gpkg

# Keep the small model datasets that were tracked before the reorg.
!data/intermediate/datasets/*.csv
!data/intermediate/models/*.csv
!data/intermediate/gazetteers/shrid_loc_names.csv
!data/final/satp_clean.csv

# Large external raw sources
data/input/external/osm/*.pbf
data/input/external/geonames/*.zip
data/input/external/lgd/*
data/input/external/shrug/*
!data/input/external/shrug/README.md
!data/input/external/shrug/open_poly.bib
